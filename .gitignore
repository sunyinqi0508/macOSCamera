# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor temp files
*.swp
*.swo
*~

# SwiftPM
.build/
.swiftpm/

# Xcode user state (the .xcodeproj itself is committed — Xcode Cloud needs it;
# regenerate after editing project.yml with `xcodegen generate`)
DerivedData/
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserdatad/
*.xcuserstate
*.xcresult
*.moved-aside
*.pbxuser
!default.pbxuser

# Build outputs and packaging artifacts
dist/
*.app
*.pkg
*.dSYM
*.dSYM.zip

# Signing material — never commit
*.provisionprofile
*.mobileprovision
*.p12
*.cer

# Logs and local caches
*.log
*.tmp
tmp/
.cache/
